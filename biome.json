{
  "$schema": "https://biomejs.dev/schemas/2.4.15/schema.json",
  "assist": { "actions": { "source": { "organizeImports": "on" } } },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "suspicious": {
        "noConsole": { "level": "off", "options": { "allow": ["log"] } }
      },
      "style": {
        "noNonNullAssertion": "off"
      }
    }
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "javascript": {
    "globals": ["chrome", "describe", "it", "expect", "test"]
  },
  "files": {
    "includes": [
      "**",
      "!**/dist/**",
      "!**/landing/**",
      "!**/node_modules/**",
      "!**/debug-test.html",
      "!**/debug-textaid.js",
      "!**/test-design.html",
      "!**/content.js",
      "!**/background.js",
      "!**/popup.js",
      "!**/scripts/**"
    ]
  }
}
