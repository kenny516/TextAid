{
  "$schema": "https://biomejs.dev/schemas/1.9.4/schema.json",
  "organizeImports": { "enabled": true },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "suspicious": {
        "noConsoleLog": "off"
      },
      "style": {
        "noNonNullAssertion": "off"
      }
    }
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "javascript": {
    "globals": ["chrome", "describe", "it", "expect", "test"]
  },
  "files": {
    "ignore": [
      "dist/**",
      "landing/**",
      "node_modules/**",
      "debug-test.html",
      "debug-textaid.js",
      "test-design.html",
      "content.js",
      "background.js",
      "popup.js",
      "scripts/**"
    ]
  }
}
