{
  "name": "textaid-extension",
  "version": "1.4.0",
  "description": "Cross-browser AI writing assistant (Chrome, Firefox, Brave, Edge, Opera, Arc, Vivaldi, Zen, Safari)",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:chrome": "node scripts/build.mjs chrome",
    "build:firefox": "node scripts/build.mjs firefox",
    "dev": "node scripts/watch.mjs",
    "dev:chrome": "node scripts/watch.mjs chrome",
    "dev:firefox": "node scripts/watch.mjs firefox",
    "version:set": "node scripts/version.mjs",
    "assets": "node store-assets/generate-assets.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "biome check lib/ tests/",
    "lint:fix": "biome check --write lib/ tests/"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.15",
    "adm-zip": "^0.5.16",
    "canvas": "^3.1.0",
    "sharp": "^0.34.2",
    "vitest": "^4.1.7"
  },
  "keywords": [
    "browser-extension",
    "chrome-extension",
    "firefox-extension",
    "ai",
    "text-assistant",
    "productivity",
    "openai",
    "gemini"
  ],
  "author": "TextAid Team",
  "license": "MIT"
}
